{
  "name": "@icety/agent-mail",
  "version": "0.3.0",
  "description": "Mail for agent apps: agents draft, the owner reviews and sends with an undo window, replies and inbound mail come back into the chat. Nuxt layer plus plain TypeScript services, SQLite or Postgres.",
  "type": "module",
  "main": "./nuxt.config.ts",
  "exports": {
    ".": "./nuxt.config.ts",
    "./nuxt.config": "./nuxt.config.ts",
    "./lib": "./lib/index.ts",
    "./sqlite": "./lib/storage/sqlite/index.ts",
    "./pg": "./lib/storage/pg/index.ts",
    "./shared/*": "./shared/*.ts",
    "./css": "./app/assets/mail.css",
    "./mail.sh": "./lib/mail.sh",
    "./app/utils/*": "./app/utils/*.ts",
    "./pg/schema": "./lib/storage/pg/schema.ts",
    "./sqlite/schema": "./lib/storage/sqlite/schema.ts"
  },
  "files": [
    "app",
    "server",
    "shared",
    "lib",
    "nuxt.config.ts",
    "README.md"
  ],
  "scripts": {
    "test": "bun test",
    "typecheck": "bunx tsc --noEmit -p tsconfig.lib.json && nuxt prepare playground && bun --bun nuxt typecheck playground",
    "build:playground": "bun --bun nuxt build playground",
    "dev": "bun --bun nuxt dev playground",
    "db:generate:sqlite": "drizzle-kit generate --config drizzle.sqlite.config.ts",
    "db:generate:pg": "drizzle-kit generate --config drizzle.pg.config.ts",
    "prepare:playground": "nuxt prepare playground"
  },
  "dependencies": {
    "imapflow": "^2.4.0",
    "mailparser": "^3.9.38",
    "nodemailer": "^10.1.0"
  },
  "peerDependencies": {
    "@nuxt/ui": "^4.0.0",
    "drizzle-orm": ">=0.45.0 <1",
    "nuxt": "^4.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.4.0 || ^0.5.0",
    "@iconify-json/lucide": "^1.2.0",
    "@nuxt/ui": "^4.0.0",
    "@types/bun": "^1.3.0",
    "@types/mailparser": "^3.9.0",
    "@types/nodemailer": "^8.0.2",
    "drizzle-kit": "^0.31.0",
    "drizzle-orm": "^0.45.0",
    "nuxt": "^4.0.0",
    "typescript": "^6.0.0",
    "vue-tsc": "^3.0.0",
    "zod": "^4.0.0"
  }
}
